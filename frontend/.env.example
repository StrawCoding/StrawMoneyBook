# Copy to .env.development.local or .env (local only; not committed).
# Google OAuth Web Client ID — create in Google Cloud Console for your own build.
VITE_GOOGLE_WEB_CLIENT_ID=
VITE_GOOGLE_USE_SERVER_AUTH_CODE=true
VITE_PRIVACY_POLICY_URL=https://www.strawmb.com/privacy-policy
VITE_BANK_SYNC_FEATURE_ENABLED=true
VITE_BANK_SYNC_ENABLE_UNSUPPORTED_REAL_PROVIDERS=false
