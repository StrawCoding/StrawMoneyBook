# npm run dev: defaults in .env.development → https://api.strawmb.com
# Local backend instead: VITE_SHARED_LEDGER_API_BASE_URL=http://127.0.0.1:8787
VITE_SHARED_LEDGER_API_BASE_URL=https://api.strawmb.com
VITE_GOOGLE_WEB_CLIENT_ID=replace-with-web-client-id.apps.googleusercontent.com
VITE_EINVOICE_CLIENT_SHARED_KEY=replace-with-same-value-as-backend-EINVOICE_CLIENT_SHARED_KEY
VITE_EINVOICE_API_BASE_URL=https://api.strawmb.com
VITE_GOOGLE_OAUTH_API_ORIGIN=https://api.strawmb.com
# Must match backend GOOGLE_OAUTH_CLIENT_SHARED_KEY. Never treat VITE_ keys baked into the APK as a trust boundary.
VITE_GOOGLE_OAUTH_CLIENT_SHARED_KEY=replace-with-same-value-as-backend-GOOGLE_OAUTH_CLIENT_SHARED_KEY
# Server-side only. Never treat VITE_ keys baked into the APK as a trust boundary.
# Hosted GitHub Pages nested SPA only (https://www.strawmb.com/app/)
# VITE_WEB_HASH_ROUTER=true
