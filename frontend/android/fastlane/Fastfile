require 'fileutils'
require 'json'

default_platform(:android)

ANDROID_PROJECT_ROOT = File.expand_path("..", __dir__)
REPO_ROOT = File.expand_path("../..", ANDROID_PROJECT_ROOT)
PENDING_RELEASE_NOTES_PATH = File.join(REPO_ROOT, "release-notes.pending.md")
CHANGELOGS_DIR = File.join(__dir__, "metadata", "android", "zh-TW", "changelogs")
PLAY_TESTING_CHANNEL_CONFIG_PATH = File.join(ANDROID_PROJECT_ROOT, "play-testing-channel.json")
PLAY_EDIT_CONFLICT_MESSAGE = "A change was made to the application outside of this Edit, please create a new edit."
PLAY_UPLOAD_MAX_ATTEMPTS = 3
PLAY_UPLOAD_RETRY_DELAY_SECONDS = 15
PLAY_CONSOLE_MAX_LENGTH = 500
DEFAULT_PHONE_AAB = "app/build/outputs/bundle/release/app-release.aab"
DEFAULT_WEAR_AAB = "wear/build/outputs/bundle/release/wear-release.aab"
DEFAULT_PHONE_TRACK = "alpha"
DEFAULT_PRODUCTION_TRACK = "production"
DEFAULT_PLAY_TESTING_CHANNEL = "internal"
WEAR_VERSION_CODE_OFFSET = 100_000_000

def require_env!(key)
  value = ENV[key].to_s.strip
  UI.user_error!("Missing required environment variable: #{key}") if value.empty?
  value
end

def resolve_existing_path(explicit_path)
  return "" if explicit_path.to_s.strip.empty?

  absolute = File.expand_path(explicit_path, ANDROID_PROJECT_ROOT)
  File.exist?(absolute) ? absolute : ""
end

def glob_last(pattern)
  Dir.glob(File.join(ANDROID_PROJECT_ROOT, pattern)).sort.last.to_s
end

def resolve_aab_path(explicit_path)
  resolved = resolve_existing_path(explicit_path)
  return resolved unless resolved.empty?

  found = glob_last("app/build/outputs/bundle/**/*.aab")
  return found unless found.empty?

  absolute = explicit_path.to_s.strip.empty? ? File.join(ANDROID_PROJECT_ROOT, DEFAULT_PHONE_AAB) : File.expand_path(explicit_path, ANDROID_PROJECT_ROOT)
  absolute
end

def resolve_wear_aab_path(explicit_path)
  resolved = resolve_existing_path(explicit_path)
  return resolved unless resolved.empty?

  glob_last("wear/build/outputs/bundle/**/*.aab")
end

def resolve_mapping_path(explicit_path)
  resolved = resolve_existing_path(explicit_path)
  return resolved unless resolved.empty?

  glob_last("app/build/outputs/mapping/**/mapping.txt")
end

def play_edit_conflict?(error)
  error.message.to_s.include?(PLAY_EDIT_CONFLICT_MESSAGE)
end

def play_track_not_found?(error)
  msg = error.message.to_s
  msg.include?("Track not found") || msg.match?(/404.*[Tt]rack/)
end

def wear_track_for_phone_track(phone_track)
  track = phone_track.to_s.strip
  return track if track.start_with?("wear:")

  "wear:#{track}"
end

def play_testing_channel_config
  @play_testing_channel_config ||= begin
    UI.user_error!("Missing Play testing channel config: #{PLAY_TESTING_CHANNEL_CONFIG_PATH}") unless File.exist?(PLAY_TESTING_CHANNEL_CONFIG_PATH)
    JSON.parse(File.read(PLAY_TESTING_CHANNEL_CONFIG_PATH))
  rescue JSON::ParserError => error
    UI.user_error!("Invalid JSON in #{PLAY_TESTING_CHANNEL_CONFIG_PATH}: #{error.message}")
  end
end

# Resolve phone+wear testing tracks from play-testing-channel.json.
# Priority: explicit PLAY_CLOSED_TESTING_TRACK / PLAY_WEAR_CLOSED_TESTING_TRACK env
# → PLAY_TESTING_CHANNEL env → JSON "channel" (default internal).
def resolve_play_testing_tracks!
  config = play_testing_channel_config
  tracks_by_channel = config["tracks"]
  UI.user_error!("play-testing-channel.json missing tracks object") unless tracks_by_channel.is_a?(Hash)

  channel = ENV.fetch("PLAY_TESTING_CHANNEL", "").to_s.strip
  channel = config["channel"].to_s.strip if channel.empty?
  channel = DEFAULT_PLAY_TESTING_CHANNEL if channel.empty?
  selected = tracks_by_channel[channel]
  unless selected.is_a?(Hash)
    UI.user_error!(
      "Unknown Play testing channel #{channel.inspect}. Allowed: #{tracks_by_channel.keys.sort.join(', ')} (see play-testing-channel.json)."
    )
  end

  phone_track = ENV.fetch("PLAY_CLOSED_TESTING_TRACK", "").to_s.strip
  wear_track = ENV.fetch("PLAY_WEAR_CLOSED_TESTING_TRACK", "").to_s.strip
  phone_track = selected["phone"].to_s.strip if phone_track.empty?
  wear_track = selected["wear"].to_s.strip if wear_track.empty?

  UI.user_error!("Resolved phone testing track is empty for channel=#{channel}") if phone_track.empty?
  UI.user_error!("Resolved wear testing track is empty for channel=#{channel}") if wear_track.empty?

  UI.message("Play testing channel=#{channel} phone=#{phone_track} wear=#{wear_track}")
  {
    channel: channel,
    phone_track: phone_track,
    wear_track: wear_track
  }
end

def wear_track_missing_help(wear_track)
  <<~HELP.gsub(/\s+/, " ").strip
    Wear track #{wear_track.inspect} does not exist for this Play app.
    Enable it in Play Console: Test and release → Advanced settings → Form factors →
    Add Wear OS → Manage → Use a dedicated release track for Wear OS → Save.
    Then re-run the v* tag workflow. Do not put the Wear AAB on the phone track
    with a combined phone+wear upload (Play requires dedicated wear:* tracks after form-factor opt-in).
  HELP
end

def upload_to_play_store_with_edit_retry!(options)
  attempts = 0

  begin
    attempts += 1
    upload_to_play_store(options)
  rescue StandardError => error
    if play_edit_conflict?(error) && attempts < PLAY_UPLOAD_MAX_ATTEMPTS
      UI.important("Google Play edit was changed outside this upload; retrying with a new edit (attempt #{attempts + 1}/#{PLAY_UPLOAD_MAX_ATTEMPTS})")
      sleep(PLAY_UPLOAD_RETRY_DELAY_SECONDS)
      retry
    end

    if play_track_not_found?(error) && options[:track].to_s.start_with?("wear:")
      UI.user_error!(wear_track_missing_help(options[:track]))
    end

    raise
  end
end

def version_code_from_name(version_name)
  clean = version_name.to_s.strip.split("-").first.to_s
  parts = clean.split(".").map(&:to_i)
  major = parts[0] || 0
  minor = parts[1] || 0
  patch = parts[2] || 0
  (major + 1) * 1_000_000 + minor * 1_000 + patch
end

def wear_version_code_from_name(version_name)
  WEAR_VERSION_CODE_OFFSET + version_code_from_name(version_name)
end

def read_pending_note_lines(notes_path)
  return [] unless File.exist?(notes_path)
  lines = []
  File.readlines(notes_path).each do |line|
    stripped = line.strip
    break if stripped == "---"
    next if stripped.empty? || stripped.start_with?("#")
    lines << stripped
  end
  lines
end

def format_for_play_console(lines, max_length = PLAY_CONSOLE_MAX_LENGTH)
  joined = lines.join("\n")
  joined.length <= max_length ? joined : joined.slice(0, max_length)
end

def prepare_play_changelogs(version_name, notes_path = PENDING_RELEASE_NOTES_PATH)
  return false if version_name.to_s.strip.empty?
  return false unless File.exist?(notes_path)

  lines = read_pending_note_lines(notes_path)
  return false if lines.empty?

  changelog = format_for_play_console(lines)
  FileUtils.mkdir_p(CHANGELOGS_DIR)
  phone_code = version_code_from_name(version_name)
  wear_code = wear_version_code_from_name(version_name)
  [phone_code, wear_code].uniq.each do |code|
    File.write(File.join(CHANGELOGS_DIR, "#{code}.txt"), changelog)
  end
  UI.message("[release-notes] Loaded #{lines.length} line(s) for version codes phone=#{phone_code} wear=#{wear_code} (#{changelog.length}/#{PLAY_CONSOLE_MAX_LENGTH} chars)")
  true
end

def phone_version_already_used?(error)
  error.message.to_s.match?(/Version code .+ has already been used/i)
end

def requested_upload_roles
  raw = ENV.fetch("PLAY_UPLOAD_ROLES", "phone,wear").to_s.downcase
  roles = raw.split(/[,\s]+/).map(&:strip).reject(&:empty?).map(&:to_sym)
  roles = [:phone, :wear] if roles.empty?
  roles
end

def collect_upload_artifacts
  roles = requested_upload_roles
  requested_phone = ENV.fetch("AAB_PATH", DEFAULT_PHONE_AAB).to_s.strip
  requested_wear = ENV.fetch("WEAR_AAB_PATH", DEFAULT_WEAR_AAB).to_s.strip
  phone_aab = resolve_aab_path(requested_phone)
  wear_aab = resolve_wear_aab_path(requested_wear)

  artifacts = []
  if roles.include?(:phone)
    UI.user_error!("AAB not found at #{phone_aab}") unless File.exist?(phone_aab)
    artifacts << { role: :phone, path: phone_aab }
  end
  if roles.include?(:wear)
    if !wear_aab.empty? && File.exist?(wear_aab)
      artifacts << { role: :wear, path: wear_aab }
      UI.message("Wear AAB will upload on dedicated Wear track: #{wear_aab}")
    else
      UI.user_error!("Wear AAB not found (PLAY_UPLOAD_ROLES includes wear). Set WEAR_AAB_PATH.")
    end
  end
  UI.user_error!("No upload artifacts selected. Set PLAY_UPLOAD_ROLES=phone,wear (or wear).") if artifacts.empty?
  artifacts
end

def play_upload_options(aab_path, json_key_path, package_name, track, mapping_path, has_changelogs)
  mapping_exists = !mapping_path.empty? && File.exist?(mapping_path)
  options = {
    package_name: package_name,
    json_key: json_key_path,
    track: track,
    release_status: "completed",
    aab: aab_path,
    skip_upload_apk: true,
    skip_upload_metadata: true,
    skip_upload_images: true,
    skip_upload_screenshots: true,
    skip_upload_changelogs: !has_changelogs
  }
  # Mapping belongs to the phone (R8) artifact only.
  options[:mapping] = mapping_path if mapping_exists && !track.to_s.start_with?("wear:")
  options
end

def assert_dedicated_wear_track!(phone_track, wear_track)
  if wear_track == phone_track || !wear_track.start_with?("wear:")
    UI.user_error!(
      "Wear track must be a dedicated form-factor track (expected wear:*), got phone=#{phone_track.inspect} wear=#{wear_track.inspect}."
    )
  end
end

def upload_phone_and_wear!(phone_track:, wear_track:, json_key_path:, package_name:, mapping_path:, has_changelogs:)
  assert_dedicated_wear_track!(phone_track, wear_track)
  artifacts = collect_upload_artifacts
  wear_optional = ENV.fetch("PLAY_WEAR_OPTIONAL", "false").to_s.strip.downcase == "true"

  artifacts.each do |artifact|
    track = artifact[:role] == :wear ? wear_track : phone_track
    UI.message("Uploading #{artifact[:role]} AAB to Play track=#{track} release_status=completed: #{artifact[:path]}")
    options = play_upload_options(
      artifact[:path],
      json_key_path,
      package_name,
      track,
      mapping_path,
      has_changelogs
    )
    begin
      upload_to_play_store_with_edit_retry!(options)
    rescue StandardError => error
      if artifact[:role] == :phone && phone_version_already_used?(error)
        UI.important("Phone version already on Play; continuing with remaining uploads: #{error.message}")
        next
      end
      if artifact[:role] == :wear && wear_optional && (play_track_not_found?(error) || error.message.to_s.include?("dedicated release track"))
        UI.important("PLAY_WEAR_OPTIONAL=true — skipping Wear upload because dedicated track is missing: #{error.message}")
        next
      end
      raise
    end
  end
end

platform :android do
  desc "Submit phone + wear AABs to Google Play production (phone=production, wear=wear:production)"
  lane :production_review do
    package_name = require_env!("ANDROID_PACKAGE_NAME")
    json_key_path = require_env!("PLAY_JSON_KEY_PATH")
    phone_track = ENV.fetch("PLAY_PRODUCTION_TRACK", DEFAULT_PRODUCTION_TRACK).to_s.strip
    wear_track = ENV.fetch("PLAY_WEAR_PRODUCTION_TRACK", wear_track_for_phone_track(phone_track)).to_s.strip
    requested_mapping_path = ENV.fetch("PLAY_MAPPING_PATH", "").to_s.strip

    UI.user_error!("Play service account json not found at #{json_key_path}") unless File.exist?(json_key_path)
    UI.user_error!("PLAY_PRODUCTION_TRACK must not be empty") if phone_track.empty?
    UI.user_error!("PLAY_WEAR_PRODUCTION_TRACK must not be empty") if wear_track.empty?

    mapping_path = resolve_mapping_path(requested_mapping_path)

    ci_version_name = ENV.fetch("CI_VERSION_NAME", "").strip
    UI.message("[release-notes] Reading pending release notes...")
    has_changelogs = prepare_play_changelogs(ci_version_name)
    if has_changelogs
      UI.message("[release-notes] Release notes ready — will upload changelogs to Google Play.")
    else
      UI.important("[release-notes] No release notes found — skipping changelog upload.")
    end

    upload_phone_and_wear!(
      phone_track: phone_track,
      wear_track: wear_track,
      json_key_path: json_key_path,
      package_name: package_name,
      mapping_path: mapping_path,
      has_changelogs: has_changelogs
    )
  end

  desc "Publish phone + wear AABs to Google Play testing tracks (channel from play-testing-channel.json: internal|closed)"
  lane :closed_testing do
    package_name = require_env!("ANDROID_PACKAGE_NAME")
    json_key_path = require_env!("PLAY_JSON_KEY_PATH")
    resolved = resolve_play_testing_tracks!
    play_track = resolved[:phone_track]
    wear_track = resolved[:wear_track]
    requested_mapping_path = ENV.fetch("PLAY_MAPPING_PATH", "").to_s.strip

    UI.user_error!("Play service account json not found at #{json_key_path}") unless File.exist?(json_key_path)

    mapping_path = resolve_mapping_path(requested_mapping_path)

    ci_version_name = ENV.fetch("CI_VERSION_NAME", "").strip
    UI.message("[release-notes] Reading pending release notes...")
    has_changelogs = prepare_play_changelogs(ci_version_name)
    if has_changelogs
      UI.message("[release-notes] Release notes ready — will upload changelogs to Google Play.")
    else
      UI.important("[release-notes] No release notes found — skipping changelog upload.")
    end

    upload_phone_and_wear!(
      phone_track: play_track,
      wear_track: wear_track,
      json_key_path: json_key_path,
      package_name: package_name,
      mapping_path: mapping_path,
      has_changelogs: has_changelogs
    )
  end
end
