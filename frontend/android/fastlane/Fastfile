require 'fileutils'

default_platform(:android)

ANDROID_PROJECT_ROOT = File.expand_path("..", __dir__)
REPO_ROOT = File.expand_path("../..", ANDROID_PROJECT_ROOT)
PENDING_RELEASE_NOTES_PATH = File.join(REPO_ROOT, "release-notes.pending.md")
CHANGELOGS_DIR = File.join(__dir__, "metadata", "android", "zh-TW", "changelogs")
PLAY_EDIT_CONFLICT_MESSAGE = "A change was made to the application outside of this Edit, please create a new edit."
PLAY_UPLOAD_MAX_ATTEMPTS = 3
PLAY_UPLOAD_RETRY_DELAY_SECONDS = 15

def require_env!(key)
  value = ENV[key].to_s.strip
  UI.user_error!("Missing required environment variable: #{key}") if value.empty?
  value
end

def resolve_aab_path(explicit_path)
  absolute_explicit_path = explicit_path.empty? ? "" : File.expand_path(explicit_path, ANDROID_PROJECT_ROOT)
  return absolute_explicit_path if !absolute_explicit_path.empty? && File.exist?(absolute_explicit_path)

  candidates = Dir.glob(File.join(ANDROID_PROJECT_ROOT, "app/build/outputs/bundle/**/*.aab")).sort
  return candidates.last unless candidates.empty?

  absolute_explicit_path.empty? ? explicit_path : absolute_explicit_path
end

def resolve_mapping_path(explicit_path)
  absolute_explicit_path = explicit_path.empty? ? "" : File.expand_path(explicit_path, ANDROID_PROJECT_ROOT)
  return absolute_explicit_path if !absolute_explicit_path.empty? && File.exist?(absolute_explicit_path)

  candidates = Dir.glob(File.join(ANDROID_PROJECT_ROOT, "app/build/outputs/mapping/**/mapping.txt")).sort
  return candidates.last unless candidates.empty?

  absolute_explicit_path.empty? ? explicit_path : absolute_explicit_path
end

def play_edit_conflict?(error)
  error.message.to_s.include?(PLAY_EDIT_CONFLICT_MESSAGE)
end

def upload_to_play_store_with_edit_retry!(options)
  attempts = 0

  begin
    attempts += 1
    upload_to_play_store(options)
  rescue StandardError => error
    raise unless play_edit_conflict?(error) && attempts < PLAY_UPLOAD_MAX_ATTEMPTS

    UI.important("Google Play edit was changed outside this upload; retrying with a new edit (attempt #{attempts + 1}/#{PLAY_UPLOAD_MAX_ATTEMPTS})")
    sleep(PLAY_UPLOAD_RETRY_DELAY_SECONDS)
    retry
  end
end

def version_code_from_name(version_name)
  clean = version_name.to_s.strip.split("-").first.to_s
  parts = clean.split(".").map(&:to_i)
  major = parts[0] || 0
  minor = parts[1] || 0
  patch = parts[2] || 0
  (major + 1) * 1_000_000 + minor * 1_000 + patch
end

def prepare_play_changelogs(version_name, notes_path = PENDING_RELEASE_NOTES_PATH)
  return false if version_name.to_s.strip.empty?
  return false unless File.exist?(notes_path)

  lines = File.readlines(notes_path).map(&:strip).reject { |l| l.empty? || l.start_with?("#") }
  return false if lines.empty?

  version_code = version_code_from_name(version_name)
  FileUtils.mkdir_p(CHANGELOGS_DIR)
  File.write(File.join(CHANGELOGS_DIR, "#{version_code}.txt"), lines.join("\n"))
  UI.message("[release-notes] Loaded #{lines.length} line(s) for version code #{version_code}")
  true
end

platform :android do
  desc "Publish the release AAB to the Google Play closed testing track"
  lane :closed_testing do
    package_name = require_env!("ANDROID_PACKAGE_NAME")
    json_key_path = require_env!("PLAY_JSON_KEY_PATH")
    play_track = ENV.fetch("PLAY_CLOSED_TESTING_TRACK", "alpha").to_s.strip
    requested_aab_path = ENV.fetch("AAB_PATH", "app/build/outputs/bundle/release/app-release.aab").to_s.strip
    requested_mapping_path = ENV.fetch("PLAY_MAPPING_PATH", "").to_s.strip
    aab_path = resolve_aab_path(requested_aab_path)
    mapping_path = resolve_mapping_path(requested_mapping_path)
    mapping_exists = !mapping_path.empty? && File.exist?(mapping_path)

    UI.user_error!("AAB not found at #{aab_path}") unless File.exist?(aab_path)
    UI.user_error!("Play service account json not found at #{json_key_path}") unless File.exist?(json_key_path)
    UI.user_error!("PLAY_CLOSED_TESTING_TRACK must not be empty") if play_track.empty?

    ci_version_name = ENV.fetch("CI_VERSION_NAME", "").strip
    UI.message("[release-notes] Reading pending release notes...")
    has_changelogs = prepare_play_changelogs(ci_version_name)
    if has_changelogs
      UI.message("[release-notes] Release notes ready — will upload changelogs to Google Play.")
    else
      UI.important("[release-notes] No release notes found — skipping changelog upload.")
    end

    upload_to_play_store_with_edit_retry!(
      package_name: package_name,
      json_key: json_key_path,
      aab: aab_path,
      mapping: mapping_exists ? mapping_path : nil,
      track: play_track,
      release_status: "completed",
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: !has_changelogs
    )
  end
end
