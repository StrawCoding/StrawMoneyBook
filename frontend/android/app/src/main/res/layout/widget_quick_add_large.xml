<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/home_widget_bg_quick_add"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="22dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#F6FFF9"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#D7F2E2"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_primary_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/home_widget_chip_primary"
        android:gravity="center"
        android:paddingLeft="18dp"
        android:paddingTop="11dp"
        android:paddingRight="18dp"
        android:paddingBottom="11dp"
        android:textColor="#0A2A17"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_secondary_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="#D7F2E2"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
