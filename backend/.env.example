NODE_ENV=production
HOST=0.0.0.0
PORT=8787
MAX_BODY_BYTES=8388608

ALLOWED_ORIGINS=*

SHARED_LEDGER_DB_FILE=.server-data/collab-store.sqlite
SHARED_LEDGER_TOKEN_SECRET=replace-with-a-long-random-secret
SHARED_LEDGER_ACCESS_TOKEN_TTL_MS=900000
SHARED_LEDGER_REFRESH_TOKEN_TTL_MS=2592000000
SHARED_LEDGER_AUTH_NONCE_TTL_MS=300000
SHARED_LEDGER_ADMIN_EMAILS=

GOOGLE_AUTH_WEB_CLIENT_ID=replace-with-web-client-id.apps.googleusercontent.com
GOOGLE_AUTH_ALLOWED_AUDIENCES=
LINEAR_API_KEY=
LINEAR_TEAM_KEY=SMB

SMTP_SERVER=127.0.0.1
SMTP_SERVER_PORT=587
SMTP_FROM=service@example.com
SMTP_USER=service@example.com
SMTP_PASS=replace-with-smtp-password
SMTP_TLS_SERVERNAME=
SMTP_TLS_REJECT_UNAUTHORIZED=false

GLOBAL_RATE_LIMIT_WINDOW_MS=60000
GLOBAL_RATE_LIMIT_MAX_REQUESTS=180
AUTH_RATE_LIMIT_WINDOW_MS=600000
AUTH_RATE_LIMIT_MAX_REQUESTS=40
