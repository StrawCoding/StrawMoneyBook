NODE_ENV=production
HOST=0.0.0.0
PORT=8787
MAX_BODY_BYTES=8388608

ALLOWED_ORIGINS=*

SHARED_LEDGER_DB_FILE=.server-data/collab-store.sqlite
SHARED_LEDGER_TOKEN_SECRET=replace-with-a-long-random-secret

SMTP_SERVER=127.0.0.1
SMTP_SERVER_PORT=587
SMTP_FROM=service@example.com
SMTP_USER=service@example.com
SMTP_PASS=replace-with-smtp-password
SMTP_TLS_SERVERNAME=
SMTP_TLS_REJECT_UNAUTHORIZED=false

GLOBAL_RATE_LIMIT_WINDOW_MS=60000
GLOBAL_RATE_LIMIT_MAX_REQUESTS=180
AUTH_RATE_LIMIT_WINDOW_MS=600000
AUTH_RATE_LIMIT_MAX_REQUESTS=40
