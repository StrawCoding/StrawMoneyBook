NODE_ENV=production
HOST=0.0.0.0
PORT=8787
MAX_BODY_BYTES=8388608

ALLOWED_ORIGINS=https://your-domain.com

SHARED_LEDGER_DB_FILE=.server-data/collab-store.sqlite
SHARED_LEDGER_TOKEN_SECRET=replace-with-a-long-random-secret
SHARED_LEDGER_ACCESS_TOKEN_TTL_MS=900000
SHARED_LEDGER_REFRESH_TOKEN_TTL_MS=2592000000
SHARED_LEDGER_AUTH_NONCE_TTL_MS=300000
SHARED_LEDGER_ADMIN_EMAILS=

GOOGLE_AUTH_WEB_CLIENT_ID=replace-with-web-client-id.apps.googleusercontent.com
GOOGLE_AUTH_ALLOWED_AUDIENCES=

# Required for Google Drive automatic backup server auth code exchange and token refresh.
# GOOGLE_AUTH_WEB_CLIENT_ID is used as the client_id fallback if GOOGLE_OAUTH_CLIENT_ID is not set.
# GOOGLE_OAUTH_CLIENT_SECRET must be set: obtain it from Google Cloud Console > APIs & Services > Credentials.
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-oauth-client-secret
LINEAR_API_KEY=
LINEAR_TEAM_KEY=SMB

SMTP_SERVER=127.0.0.1
SMTP_SERVER_PORT=587
SMTP_FROM=service@example.com
SMTP_USER=service@example.com
SMTP_PASS=replace-with-smtp-password
SMTP_TLS_SERVERNAME=
SMTP_TLS_REJECT_UNAUTHORIZED=true

GLOBAL_RATE_LIMIT_WINDOW_MS=60000
GLOBAL_RATE_LIMIT_MAX_REQUESTS=180
AUTH_RATE_LIMIT_WINDOW_MS=600000
AUTH_RATE_LIMIT_MAX_REQUESTS=40

# 電子發票爬蟲（必填；前端需同步設定 VITE_EINVOICE_CLIENT_SHARED_KEY）
EINVOICE_CLIENT_SHARED_KEY=replace-with-a-long-random-shared-key
EINVOICE_SCRAPE_USE_PLAYWRIGHT=1
# EINVOICE_SCRAPE_MOCK=1
# 生產環境使用 Playwright 內建 Chromium（非系統 Chrome）；首次部署或升級後需 npm run playwright:install-browsers
# PLAYWRIGHT_BROWSERS_PATH=.server-data/playwright-browsers
# PLAYWRIGHT_INSTALL_BROWSERS=1
# EINVOICE_PORTAL_LOGIN_URL=
# EINVOICE_SCRAPE_SELECTORS_JSON=
